{
  "name": "geo-engine-node",
  "version": "3.0.0-rc.1",
  "type": "module",
  "description": "Official Node.js and TypeScript SDK for the Geo-Engine platform.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./identity": {
      "import": {
        "types": "./dist/identity.d.ts",
        "default": "./dist/identity.js"
      },
      "require": {
        "types": "./dist/identity.d.cts",
        "default": "./dist/identity.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README*",
    "LICENSE",
    "CHANGELOG*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexG695/geo-engine-node.git"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/*.test.ts && npm run build && npm run test:identity && npm run test:formats",
    "test:unit": "vitest run tests/*.test.ts",
    "test:identity": "node --test tests/identity.test.mjs",
    "test:watch": "vitest tests/*.test.ts",
    "example": "node examples/simulation.js",
    "prepublishOnly": "npm run typecheck && npm run test",
    "test:formats": "node --test tests/formats.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "geoengine",
    "geofencing",
    "spatial",
    "location",
    "tracking",
    "postgis",
    "telemetry",
    "sdk",
    "typescript"
  ],
  "author": "Geo-Engine Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
