{
  "name": "geo-engine-node",
  "version": "2.0.0",
  "type": "module",
  "description": "Official Node.js and TypeScript SDK for the Geo-Engine platform.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "node examples/simulation.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "geoengine",
    "geofencing",
    "spatial",
    "location",
    "tracking",
    "postgis",
    "telemetry",
    "sdk",
    "typescript"
  ],
  "author": "Geo-Engine Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
